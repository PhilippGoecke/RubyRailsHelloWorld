FROM debian:trixie-slim as install

ARG DEBIAN_FRONTEND=noninteractive

#SHELL ["/bin/bash", "-c"]
RUN rm /bin/sh \
  && ln -s /bin/bash /bin/sh

# install dependencies
RUN apt update && apt upgrade -y \
  && apt install -y --no-install-recommends --no-install-suggests ca-certificates git curl libyaml-dev build-essential libssl-dev zlib1g-dev libvips \
  && rm -rf "/var/lib/apt/lists/*" \
  && rm -rf /var/cache/apt/archives

# add user and set home directory
ARG USER=rails
RUN useradd --create-home --shell /bin/bash $USER
ARG HOME="/home/$USER"
WORKDIR $HOME
USER $USER

# install Ruby, Node.js, Yarn
ENV NODE_VERSION=24.19.0
RUN git clone --depth 1 https://github.com/nvm-sh/nvm.git ~/.nvm \
  && cd .nvm \
  && . $HOME/.nvm/nvm.sh \
  && nvm --version \
  && nvm install $NODE_VERSION \
  && npm --version \
  && npm install --global yarn \
  && which yarn \
  && yarn --version
ENV PATH="$HOME/.nvm/versions/node/v$NODE_VERSION/bin/:$PATH"

# install Ruby using rbenv
ENV RUBY_CONFIGURE_OPTS="--disable-install-rdoc"
ENV PATH="$HOME/.rbenv/bin:$PATH"
RUN git clone --depth 1 https://github.com/rbenv/rbenv.git ~/.rbenv \
  && ~/.rbenv/bin/rbenv init \
  && rbenv --version \
  && mkdir "$(rbenv root)"/plugins/ \
  && git clone --depth 1 https://github.com/rbenv/ruby-build.git "$(rbenv root)"/plugins/ruby-build \
  && rbenv install 4.0.6 \
  && rbenv global 4.0.6
ENV PATH="$HOME/.rbenv/shims:$PATH"

WORKDIR /rails/tinc-vpns

# install Rails and initialize a new Rails app
RUN bundle init \
  && bundle add rails --version "~> 8.1.3.1" \
  && bundle update --bundler \
  && bundle exec rails new . --force --skip-git --database=sqlite3 --javascript=esbuild --asset-pipeline=propshaft \
  && sed -i 's/<body>/<body>\n  <!-- <%= RUBY_VERSION %> <%= Rails.version %> <%= Bundler::VERSION %> -->/g' app/views/layouts/application.html.erb

# scaffold models to manage tinc VPN networks and their nodes (ip, dns, public key)
RUN bundle exec rails generate scaffold Network name:string:uniq subnet:string description:text \
  && bundle exec rails generate scaffold Node network:references name:string ip:string dns:string public_key:text \
  && sed -i 's/belongs_to :network/belongs_to :network/;s/class Network < ApplicationRecord/class Network < ApplicationRecord\n  has_many :nodes, dependent: :destroy\n  validates :name, presence: true, uniqueness: true/' app/models/network.rb \
  && sed -i 's/class Node < ApplicationRecord/class Node < ApplicationRecord\n  validates :name, presence: true, uniqueness: { scope: :network_id }\n  validates :ip, presence: true\n  validates :public_key, presence: true/' app/models/node.rb \
  && sed -i 's|# root "posts#index"|root "networks#index"|' config/routes.rb \
  && sed -i 's|resources :networks|resources :networks do\n    resources :nodes, only: [:new, :create]\n  end|' config/routes.rb \
  && sed -i '0,/<%= form.text_field :network_id %>/s||<%= form.hidden_field :network_id %>|' app/views/nodes/_form.html.erb \
  && sed -i 's|form_with(model: node)|form_with(model: node, url: node.new_record? ? network_nodes_path(node.network) : node_path(node))|' app/views/nodes/_form.html.erb \
  && sed -i 's|def new\n    @node = Node.new\n  end|def new\n    @network = Network.find(params[:network_id])\n    @node = @network.nodes.build\n  end|' app/controllers/nodes_controller.rb \
  && perl -0pi -e 's/def new\n    \@node = Node\.new\n  end/def new\n    \@network = Network.find(params[:network_id])\n    \@node = \@network.nodes.build\n  end/' app/controllers/nodes_controller.rb \
  && perl -0pi -e 's/def create\n    \@node = Node\.new\(node_params\)/def create\n    \@network = Network.find(params[:network_id])\n    \@node = \@network.nodes.build(node_params)/' app/controllers/nodes_controller.rb \
  && sed -i 's|<%= link_to "Edit this network"|<%= link_to "🖥️ New node", new_network_node_path(@network) %>\n\n  <%= link_to "Edit this network"|' app/views/networks/show.html.erb \
  && bundle exec rails db:prepare

# � Add Devise + CanCanCan: accounts, network memberships and an admin role
RUN bundle add devise \
  && bundle add cancancan \
  && bundle exec rails generate devise:install \
  && bundle exec rails generate devise Account \
  && sed -i 's/class Account < ApplicationRecord/class Account < ApplicationRecord\n  has_many :memberships, dependent: :destroy\n  has_many :networks, through: :memberships\n  def admin?\n    admin\n  end/' app/models/account.rb \
  && bundle exec rails generate migration AddAdminToAccounts admin:boolean \
  && sed -i 's/add_column :accounts, :admin, :boolean/add_column :accounts, :admin, :boolean, default: false, null: false/' db/migrate/*_add_admin_to_accounts.rb \
  && bundle exec rails generate scaffold Membership account:references network:references \
  && sed -i 's/class Membership < ApplicationRecord/class Membership < ApplicationRecord\n  validates :account_id, uniqueness: { scope: :network_id }/' app/models/membership.rb \
  && sed -i 's/has_many :nodes, dependent: :destroy/has_many :nodes, dependent: :destroy\n  has_many :memberships, dependent: :destroy\n  has_many :accounts, through: :memberships/' app/models/network.rb \
  && printf '%s\n' \
  'class Ability' \
  '  include CanCan::Ability' \
  '' \
  '  def initialize(account)' \
  '    return if account.blank?' \
  '    if account.admin?' \
  '      can :manage, :all' \
  '    else' \
  '      can :read, Network, memberships: { account_id: account.id }' \
  '      can :download, Network, memberships: { account_id: account.id }' \
  '      can :read, Node, network: { memberships: { account_id: account.id } }' \
  '    end' \
  '  end' \
  'end' \
  > app/models/ability.rb \
  && sed -i 's/class ApplicationController < ActionController::Base/class ApplicationController < ActionController::Base\n  before_action :authenticate_account!\n\n  def current_ability\n    @current_ability ||= Ability.new(current_account)\n  end\n\n  rescue_from CanCan::AccessDenied do |exception|\n    redirect_to root_path, alert: exception.message\n  end/' app/controllers/application_controller.rb \
  && sed -i 's/class NetworksController < ApplicationController/class NetworksController < ApplicationController\n  load_and_authorize_resource/' app/controllers/networks_controller.rb \
  # restrict network creation to admins (CanCanCan ability) and hide links from unauthorized accounts
  && sed -i "s/can :manage, Network/can [:read, :update, :destroy], Network\n      can :create, Network if account.admin?/" app/models/ability.rb \
  && sed -i 's|<%= link_to "New network", new_network_path %>|<%= link_to "New network", new_network_path if can? :create, Network %>|' app/views/networks/index.html.erb \
  # only list networks the account can see (accessible_by via load_and_authorize_resource)
  && sed -i 's/def index\n    @networks = Network.all\n  end/def index\n  end/' app/controllers/networks_controller.rb \
  && perl -0pi -e 's/def index\n    \@networks = Network\.all\n  end/def index\n    \@networks = Network.accessible_by(current_ability)\n  end/' app/controllers/networks_controller.rb \
  # Nodes
  && sed -i 's/class NodesController < ApplicationController/class NodesController < ApplicationController\n  load_and_authorize_resource/' app/controllers/nodes_controller.rb \
  && sed -i 's/class MembershipsController < ApplicationController/class MembershipsController < ApplicationController\n  load_and_authorize_resource/' app/controllers/memberships_controller.rb \
  && sed -i 's|<%= form.text_field :account_id %>|<%= form.collection_select :account_id, Account.all, :id, :email %>|' app/views/memberships/_form.html.erb \
  && sed -i 's|<%= form.text_field :network_id %>|<%= form.collection_select :network_id, Network.all, :id, :name %>|' app/views/memberships/_form.html.erb \
  # show all members of a network on the network show page
  && printf '%s\n' \
  '<h2>👥 Members</h2>' \
  '<% if @network.accounts.any? %>' \
  '  <ul>' \
  '    <% @network.accounts.each do |account| %>' \
  '      <li><%= account.email %></li>' \
  '    <% end %>' \
  '  </ul>' \
  '<% else %>' \
  '  <p>No members yet.</p>' \
  '<% end %>' \
  > app/views/networks/_members.html.erb \
  && sed -i 's|<%= link_to "🖥️ New node", new_network_node_path(@network) %>|<%= render "members" %>\n\n  <%= link_to "🖥️ New node", new_network_node_path(@network) %>|' app/views/networks/show.html.erb \
  && sed -i 's/# config.mailer_sender/config.mailer_sender/' config/initializers/devise.rb \
  && echo 'Rails.application.config.action_mailer.default_url_options = { host: "localhost", port: 3000 }' > config/initializers/mailer_defaults.rb \
  && bundle exec rails db:migrate \
  && bundle exec rails runner 'Account.create!(email: "admin@example.com", password: "changeme!", admin: true) unless Account.exists?(email: "admin@example.com")'

# �📦 Add a .tar.gz download for a network including all its nodes' host files
RUN sed -i 's|resources :networks do|resources :networks do\n    member do\n      get :download\n    end|' config/routes.rb \
  && printf '%s\n' \
  'require "rubygems/package"' \
  'require "zlib"' \
  '' \
  'module NetworksHelper' \
  'end' \
  > app/helpers/networks_helper.rb \
  && printf '%s\n' \
  '  def download' \
  '    network = Network.find(params[:id])' \
  '    require "rubygems/package"' \
  '    require "zlib"' \
  '    require "stringio"' \
  '    io = StringIO.new' \
  '    Zlib::GzipWriter.wrap(io) do |gz|' \
  '      Gem::Package::TarWriter.new(gz) do |tar|' \
  '        conf = "Name = #{network.name}\n# Subnet: #{network.subnet}\n"' \
  '        tar.add_file_simple("#{network.name}/tinc.conf", 0o644, conf.bytesize) { |f| f.write(conf) }' \
  '        network.nodes.each do |node|' \
  '          host = "Address = #{node.dns.presence || node.ip}\nSubnet = #{node.ip}/32\n\n#{node.public_key}\n"' \
  '          tar.add_file_simple("#{network.name}/hosts/#{node.name}", 0o644, host.bytesize) { |f| f.write(host) }' \
  '        end' \
  '      end' \
  '    end' \
  '    send_data io.string, filename: "#{network.name}.tar.gz", type: "application/gzip"' \
  '  end' \
  > /tmp/download_action.rb \
  && sed -i '/def index/e cat /tmp/download_action.rb' app/controllers/networks_controller.rb \
  && rm /tmp/download_action.rb \
  && sed -i 's|<%= link_to "Edit this network"|<%= link_to "📦 Download .tar.gz", download_network_path(@network) %>\n\n  <%= link_to "Edit this network"|' app/views/networks/show.html.erb || true

# 🔗 Per-account ConnectTo selection: each user picks ConnectTo nodes per network,
# saved in the DB and rendered as ConnectTo lines in the downloaded tinc.conf
RUN bundle exec rails generate model ConnectToSelection account:references node:references \
  && sed -i 's/class ConnectToSelection < ApplicationRecord/class ConnectToSelection < ApplicationRecord\n  validates :node_id, uniqueness: { scope: :account_id }/' app/models/connect_to_selection.rb \
  && sed -i 's/has_many :memberships, dependent: :destroy\n  has_many :networks, through: :memberships/has_many :memberships, dependent: :destroy\n  has_many :networks, through: :memberships/' app/models/account.rb \
  && perl -0pi -e 's/(class Account < ApplicationRecord\n)/$1  has_many :connect_to_selections, dependent: :destroy\n/' app/models/account.rb \
  && perl -0pi -e 's/(class Node < ApplicationRecord\n)/$1  has_many :connect_to_selections, dependent: :destroy\n/' app/models/node.rb \
  # route to save the selection per network
  && sed -i 's|      get :download|      get :download\n      patch :connect_tos|' config/routes.rb \
  # ability: members may manage their own selections
  && sed -i "s|      can :read, Node, network: { memberships: { account_id: account.id } }|      can :read, Node, network: { memberships: { account_id: account.id } }\n      can :connect_tos, Network, memberships: { account_id: account.id }\n      can :manage, ConnectToSelection, account_id: account.id|" app/models/ability.rb \
  # controller action: persist the selected ConnectTo nodes for current_account
  && printf '%s\n' \
  '  def connect_tos' \
  '    network = Network.find(params[:id])' \
  '    node_ids = Array(params[:node_ids]).map(&:to_i) & network.node_ids' \
  '    ConnectToSelection.where(account: current_account, node_id: network.node_ids).destroy_all' \
  '    node_ids.each { |nid| ConnectToSelection.create!(account: current_account, node_id: nid) }' \
  '    redirect_to network_path(network), notice: "ConnectTo nodes saved."' \
  '  end' \
  > /tmp/connect_tos_action.rb \
  && sed -i '/def index/e cat /tmp/connect_tos_action.rb' app/controllers/networks_controller.rb \
  && rm /tmp/connect_tos_action.rb \
  # download: include the account'"'"'s saved ConnectTo nodes in tinc.conf
  && perl -0pi -e 's/(conf = "Name = \#\{network\.name\}\\n\# Subnet: \#\{network\.subnet\}\\n")/$1\n        selected = network.nodes.joins(:connect_to_selections).where(connect_to_selections: { account_id: current_account.id })\n        selected.each { |n| conf << "ConnectTo = \#{n.name}\\n" }/' app/controllers/networks_controller.rb \
  # UI: checkbox form on the network page to choose ConnectTo nodes
  && printf '%s\n' \
  '<h2>🔗 ConnectTo nodes</h2>' \
  '<%= form_with url: connect_tos_network_path(@network), method: :patch do |form| %>' \
  '  <% selected_ids = ConnectToSelection.where(account: current_account, node_id: @network.node_ids).pluck(:node_id) %>' \
  '  <% @network.nodes.each do |node| %>' \
  '    <label style="text-transform:none;display:block">' \
  '      <%= check_box_tag "node_ids[]", node.id, selected_ids.include?(node.id) %> <%= node.name %>' \
  '    </label>' \
  '  <% end %>' \
  '  <%= form.submit "Save ConnectTo" %>' \
  '<% end %>' \
  > app/views/networks/_connect_tos.html.erb \
  && sed -i 's|<%= link_to "📦 Download .tar.gz", download_network_path(@network) %>|<%= render "connect_tos" %>\n\n  <%= link_to "📦 Download .tar.gz", download_network_path(@network) %>|' app/views/networks/show.html.erb \
  && bundle exec rails db:migrate

# ✨ Beautify the UI: emoji icons, a navbar, cards and a modern dark-glass theme
RUN printf '%s\n' \
  ':root { --bg: #0f172a; --panel: rgba(30, 41, 59, 0.75); --accent: #38bdf8; --accent2: #a78bfa; --text: #e2e8f0; --muted: #94a3b8; }' \
  '* { box-sizing: border-box; }' \
  'body { margin: 0; min-height: 100vh; font-family: "Segoe UI", system-ui, sans-serif; color: var(--text); background: radial-gradient(1200px 600px at 10% -10%, #1e3a5f 0%, transparent 60%), radial-gradient(1000px 500px at 90% 110%, #3b2a5f 0%, transparent 60%), var(--bg); }' \
  'nav.topbar { display: flex; align-items: center; gap: 1rem; padding: 0.9rem 1.5rem; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(148, 163, 184, 0.2); position: sticky; top: 0; }' \
  'nav.topbar .brand { font-size: 1.25rem; font-weight: 700; background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; text-decoration: none; }' \
  'nav.topbar a { color: var(--muted); text-decoration: none; transition: color 0.2s; }' \
  'nav.topbar a:hover { color: var(--accent); }' \
  'main { max-width: 960px; margin: 2rem auto; padding: 0 1.25rem; }' \
  'h1 { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; letter-spacing: 0.01em; }' \
  'h1::before { content: "🌐"; }' \
  'div[id^="network_"], div[id^="node_"] { background: var(--panel); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 14px; padding: 1.1rem 1.4rem; margin: 1rem 0; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); transition: transform 0.15s ease, border-color 0.15s ease; }' \
  'div[id^="network_"]:hover, div[id^="node_"]:hover { transform: translateY(-2px); border-color: var(--accent); }' \
  'a { color: var(--accent); }' \
  'a[href$="/new"]::before { content: "➕ "; }' \
  'a[href$="/edit"]::before { content: "✏️ "; }' \
  'input[type="submit"], button { background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #0f172a; font-weight: 600; border: none; border-radius: 10px; padding: 0.55rem 1.2rem; cursor: pointer; transition: filter 0.2s, transform 0.1s; }' \
  'input[type="submit"]:hover, button:hover { filter: brightness(1.15); transform: translateY(-1px); }' \
  'input[type="text"], textarea { width: 100%; max-width: 480px; background: rgba(15, 23, 42, 0.7); color: var(--text); border: 1px solid rgba(148, 163, 184, 0.3); border-radius: 10px; padding: 0.6rem 0.8rem; margin: 0.25rem 0 0.75rem; }' \
  'input:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25); }' \
  'label { color: var(--muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.06em; }' \
  'p[style*="color: green"], #notice { background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); color: #4ade80; border-radius: 10px; padding: 0.7rem 1rem; }' \
  '#notice::before { content: "✅ "; }' \
  'footer { text-align: center; color: var(--muted); padding: 2rem 0 1.5rem; font-size: 0.85rem; }' \
  > app/assets/stylesheets/theme.css \
  && sed -i 's|<body>|<body>\n    <nav class="topbar">\n      <a class="brand" href="/">🔐 Tinc VPNs</a>\n      <% if account_signed_in? %>\n        <a href="/networks">🌐 Networks</a>\n        <a href="/nodes">🖥️ Nodes</a>\n        <% if current_account.admin? %>\n          <%= link_to "👥 Memberships", memberships_path %>\n        <% end %>\n        <%= button_to "🚪 Sign out", destroy_account_session_path, method: :delete %>\n      <% end %>\n    </nav>|' app/views/layouts/application.html.erb \
  && sed -i 's|</body>|  <footer>⚡ Powered by Rails · 🛡️ Secure tinc VPN management</footer>\n  </body>|' app/views/layouts/application.html.erb \
  && sed -i 's/<h1>Networks<\/h1>/<h1>Networks<\/h1>/;s/New network/🆕 New network/g' app/views/networks/index.html.erb || true

ENV RAILS_SERVE_STATIC_FILES=true
# precompile assets so /assets/application.css and /assets/application.js exist
RUN npm install --global esbuild \
  && SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

# Migration Re-sequencer: rewrite all migration timestamps to stable, sequential IDs
# (00000000000001, 00000000000002, ...) sorted by their original timestamp. This makes
# migration filenames deterministic across builds so image layers stay cacheable and
# schema.rb diffs are stable. Updates filenames, the `schema_migrations` rows in the
# database and the version references in db/schema.rb (if present).
RUN printf '%s\n' \
  '#!/usr/bin/env ruby' \
  '# Re-sequence Rails migration timestamps to deterministic, sequential IDs.' \
  'require "fileutils"' \
  'migrate_dir = File.expand_path("../db/migrate", __dir__)' \
  'abort("[resequence] no db/migrate directory") unless Dir.exist?(migrate_dir)' \
  'files = Dir.children(migrate_dir).grep(/\A\d+_.+\.rb\z/).sort_by { |f| f[/\A(\d+)_/, 1].to_i }' \
  'mapping = {}' \
  'files.each_with_index do |name, idx|' \
  '  old_ts = name[/\A(\d+)_/, 1]' \
  '  new_ts = format("%014d", idx + 1)' \
  '  next if old_ts == new_ts' \
  '  new_name = name.sub(/\A\d+_/, "#{new_ts}_")' \
  '  target = File.join(migrate_dir, new_name)' \
  '  abort("[resequence] collision: #{new_name}") if File.exist?(target)' \
  '  FileUtils.mv(File.join(migrate_dir, name), target)' \
  '  mapping[old_ts] = new_ts' \
  '  puts "[resequence] #{name} -> #{new_name}"' \
  'end' \
  'exit 0 if mapping.empty?' \
  'schema = File.expand_path("../db/schema.rb", __dir__)' \
  'if File.exist?(schema)' \
  '  content = File.read(schema)' \
  '  mapping.each do |old_ts, new_ts|' \
  '    content.gsub!(old_ts, new_ts)' \
  '    # Rails writes the schema version in underscored form, e.g. 2024_01_01_000000' \
  '    old_us = old_ts.gsub(/\A(\d{4})(\d{2})(\d{2})(\d{6})\z/, "\\1_\\2_\\3_\\4")' \
  '    new_i = new_ts.to_i.to_s' \
  '    content.gsub!(old_us, new_i) if old_us != old_ts' \
  '  end' \
  '  File.write(schema, content)' \
  '  puts "[resequence] updated db/schema.rb"' \
  'end' \
  'begin' \
  '  require_relative "../config/environment"' \
  '  mapping.each do |old_ts, new_ts|' \
  '    ActiveRecord::Base.connection.execute("UPDATE schema_migrations SET version = #{ActiveRecord::Base.connection.quote(new_ts)} WHERE version = #{ActiveRecord::Base.connection.quote(old_ts)}")' \
  '  end' \
  '  puts "[resequence] updated schema_migrations table"' \
  'rescue StandardError => e' \
  '  warn "[resequence] skipped schema_migrations update: #{e.message}"' \
  'end' > bin/resequence_migrations \
  && chmod +x bin/resequence_migrations \
  && ruby bin/resequence_migrations

# new stage for Rails app
FROM debian:trixie-slim as rails

# install dependencies
RUN apt update && apt upgrade -y \
  && apt install -y --no-install-recommends --no-install-suggests libyaml-dev libssl-dev openssl libvips \
  && apt install -y --no-install-recommends --no-install-suggests curl \
  && rm -rf "/var/lib/apt/lists/*" \
  && rm -rf /var/cache/apt/archives

# add user and set home directory
ARG USER=rails
RUN useradd --create-home --shell /bin/bash $USER
ARG HOME="/home/$USER"
WORKDIR $HOME
USER $USER

# copy rbenv, Ruby and Rails App from install stage (chown so SQLite can open/create the database file)
COPY --from=install --chown=$USER:$USER $HOME/.rbenv $HOME/.rbenv
ENV PATH="$HOME/.rbenv/shims:$PATH"
COPY --from=install --chown=$USER:$USER /rails/tinc-vpns /rails/tinc-vpns

WORKDIR /rails/tinc-vpns

RUN mkdir -p tmp/sockets tmp/pids tmp/cache log storage

# generate self-signed TLS certificate
RUN mkdir -p config/ssl \
  && openssl req -x509 -newkey rsa:4096 -nodes -keyout config/ssl/server.key -out config/ssl/server.crt -days 365 -subj "/CN=localhost"

ENV RAILS_ENV=production

EXPOSE 3000

HEALTHCHECK --interval=35s --timeout=4s CMD curl --fail --insecure https://localhost:3000/up || exit 1

CMD ["sh", "-c", "bundle exec rails db:migrate 2>&1 || true && bundle exec rails server -b 'ssl://[::]:3000?key=config/ssl/server.key&cert=config/ssl/server.crt'"]
