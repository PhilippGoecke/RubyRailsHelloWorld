FROM debian:trixie-slim as install

ARG DEBIAN_FRONTEND=noninteractive

#SHELL ["/bin/bash", "-c"]
RUN rm /bin/sh \
  && ln -s /bin/bash /bin/sh

# install dependencies
RUN apt update && apt upgrade -y \
  && apt install -y --no-install-recommends --no-install-suggests ca-certificates git curl libyaml-dev build-essential libssl-dev zlib1g-dev \
  && rm -rf "/var/lib/apt/lists/*" \
  && rm -rf /var/cache/apt/archives

# add user and set home directory
ARG USER=rails
RUN useradd --create-home --shell /bin/bash $USER
ARG HOME="/home/$USER"
WORKDIR $HOME
USER $USER

# install Ruby, Node.js, Yarn
ENV NODE_VERSION=24.18.1
RUN git clone --depth 1 https://github.com/nvm-sh/nvm.git ~/.nvm \
  && cd .nvm \
  && . $HOME/.nvm/nvm.sh \
  && nvm --version \
  && nvm install $NODE_VERSION \
  && npm --version \
  && npm install --global yarn \
  && which yarn \
  && yarn --version
ENV PATH="$HOME/.nvm/versions/node/v$NODE_VERSION/bin/:$PATH"

# install Ruby using rbenv
ENV RUBY_CONFIGURE_OPTS="--disable-install-rdoc"
ENV PATH="$HOME/.rbenv/bin:$PATH"
RUN git clone --depth 1 https://github.com/rbenv/rbenv.git ~/.rbenv \
  && ~/.rbenv/bin/rbenv init \
  && rbenv --version \
  && mkdir "$(rbenv root)"/plugins/ \
  && git clone --depth 1 https://github.com/rbenv/ruby-build.git "$(rbenv root)"/plugins/ruby-build \
  && rbenv install 4.0.6 \
  && rbenv global 4.0.6
ENV PATH="$HOME/.rbenv/shims:$PATH"

WORKDIR /rails/demo

# install Rails and initialize a new Rails app
RUN bundle init \
  && bundle add rails --version "~> 8.1.3.1" \
  && bundle update --bundler \
  && bundle exec rails new . --force --skip-git --database=sqlite3 --javascript=esbuild --css=bootstrap --asset-pipeline=propshaft \
  && sed -i 's/allow_browser/# allow_browser/g' app/controllers/application_controller.rb \
  && bundle exec rails generate controller welcome index \
  && sed -i 's/# root/root to: "welcome#index"\n  # root/g' config/routes.rb \
  && sed -i '/def index/a \ \ \ \ @name = params[:name] || "World"' app/controllers/welcome_controller.rb \
  && echo '<div class="d-flex justify-content-center align-items-center vh-100"><h1 class="text-primary text-center">Hello <%= @name %>!</h1></div>' > app/views/welcome/index.html.erb \
  && echo '<div class="text-muted small mt-3"><p>IP: <%= request.ip %></p><p>User Agent: <%= request.user_agent %></p><p>Method: <%= request.method %> Path: <%= request.path %></p></div>' >> app/views/welcome/index.html.erb \
  && sed -i 's/<body>/<body>\n  <!-- <%= RUBY_VERSION %> <%= Rails.version %> <%= Bundler::VERSION %> -->/g' app/views/layouts/application.html.erb \
  && bundle exec rails assets:precompile

# Meter App: manage meters (e.g. water, power) and their readings, with usage plots
RUN bundle add chartkick \
  && bundle add groupdate \
  && yarn add chartkick chart.js \
  && bundle exec rails generate scaffold Meter name:string kind:string unit:string \
  && bundle exec rails generate scaffold Reading meter:references value:decimal recorded_at:datetime \
  && bundle exec rails db:migrate \
  && sed -i '/belongs_to :meter/a \ \ validates :value, presence: true, numericality: true\n  validates :recorded_at, presence: true' app/models/reading.rb \
  && sed -i '/class Meter < ApplicationRecord/a \ \ has_many :readings, dependent: :destroy\n  validates :name, presence: true\n  validates :kind, presence: true, inclusion: { in: %w[water power] }\n\n  # usage per day within a period (consumption = difference between consecutive readings)\n  def usage_between(from, to)\n    rs = readings.where(recorded_at: from..to).order(:recorded_at)\n    rs.each_cons(2).map { |a, b| [b.recorded_at.to_date, (b.value - a.value).to_f] }\n      .group_by(&:first).transform_values { |v| v.sum(&:last).round(3) }\n  end' app/models/meter.rb \
  && sed -i 's|import "@hotwired/turbo-rails"|import "@hotwired/turbo-rails"\nimport "chartkick/chart.js"|' app/javascript/application.js \
  && sed -i 's/# root/get "meters\/:id\/usage", to: "meters#usage", as: :meter_usage\n  # root/g' config/routes.rb \
  && sed -i '/def show/i \ \ def usage\n    @meter = Meter.find(params[:id])\n    @from = params[:from].present? ? Time.zone.parse(params[:from]) : 30.days.ago\n    @to = params[:to].present? ? Time.zone.parse(params[:to]) : Time.zone.now\n    @usage = @meter.usage_between(@from, @to)\n  end\n' app/controllers/meters_controller.rb \
  && echo '<h1 class="mb-4">Usage for <%= @meter.name %> (<%= @meter.kind == "power" ? "Watt" : "m³" %>)</h1>' > app/views/meters/usage.html.erb \
  && echo '<%= form_with url: meter_usage_path(@meter), method: :get, class: "row g-3 mb-4" do |f| %><div class="col-auto"><%= f.label :from, class: "form-label" %><%= f.datetime_field :from, value: @from.strftime("%Y-%m-%dT%H:%M"), class: "form-control" %></div><div class="col-auto"><%= f.label :to, class: "form-label" %><%= f.datetime_field :to, value: @to.strftime("%Y-%m-%dT%H:%M"), class: "form-control" %></div><div class="col-auto align-self-end"><%= f.submit "Show", class: "btn btn-primary" %></div><% end %>' >> app/views/meters/usage.html.erb \
  && echo '<%= column_chart @usage, suffix: (@meter.kind == "power" ? " W" : " m³"), colors: [@meter.kind == "power" ? "#f0ad4e" : "#0d6efd"], xtitle: "Date", ytitle: (@meter.kind == "power" ? "Power (Watt)" : "Water (m³)"), height: "400px" %>' >> app/views/meters/usage.html.erb \
  && echo '<p class="mt-3"><%= link_to "Back to meter", @meter, class: "btn btn-secondary" %></p>' >> app/views/meters/usage.html.erb \
  && sed -i 's|<%= link_to "Edit this meter", edit_meter_path(@meter) %>|<%= link_to "Usage plot", meter_usage_path(@meter), class: "btn btn-info" %>\n  <%= link_to "Edit this meter", edit_meter_path(@meter) %>|' app/views/meters/show.html.erb \
  # impoort/export readings as Excel file
  && bundle add caxlsx \
  && bundle add caxlsx_rails \
  && bundle add roo \
  && sed -i 's/# root/get "meters\/:id\/export", to: "meters#export", as: :meter_export\n  post "meters\/:id\/import", to: "meters#import", as: :meter_import\n  # root/g' config/routes.rb \
  && sed -i '/def show/i \ \ # export readings as Excel file\n  def export\n    @meter = Meter.find(params[:id])\n    package = Axlsx::Package.new\n    package.workbook.add_worksheet(name: "Readings") do |sheet|\n      sheet.add_row ["Recorded At", "Value"]\n      @meter.readings.order(:recorded_at).each do |r|\n        sheet.add_row [r.recorded_at.strftime("%Y-%m-%d %H:%M:%S"), r.value.to_f]\n      end\n    end\n    send_data package.to_stream.read, filename: "#{@meter.name.parameterize}-readings.xlsx", type: "application\/vnd.openxmlformats-officedocument.spreadsheetml.sheet"\n  end\n\n  # import readings from Excel file\n  def import\n    @meter = Meter.find(params[:id])\n    if params[:file].blank?\n      redirect_to @meter, alert: "Please select an Excel file." and return\n    end\n    xlsx = Roo::Spreadsheet.open(params[:file].tempfile.path, extension: :xlsx)\n    count = 0\n    xlsx.sheet(0).each_row_streaming(offset: 1) do |row|\n      recorded_at = row[0]&.value\n      value = row[1]&.value\n      next if recorded_at.blank? || value.blank?\n      recorded_at = Time.zone.parse(recorded_at.to_s) unless recorded_at.is_a?(Time) || recorded_at.is_a?(DateTime)\n      @meter.readings.create!(recorded_at: recorded_at, value: value)\n      count += 1\n    end\n    redirect_to @meter, notice: "Imported #{count} readings."\n  rescue => e\n    redirect_to @meter, alert: "Import failed: #{e.message}"\n  end\n' app/controllers/meters_controller.rb \
  && sed -i 's|<%= link_to "Usage plot", meter_usage_path(@meter), class: "btn btn-info" %>|<%= link_to "Usage plot", meter_usage_path(@meter), class: "btn btn-info" %>\n  <%= link_to "Export Excel", meter_export_path(@meter), class: "btn btn-success" %>\n  <%= form_with url: meter_import_path(@meter), method: :post, class: "d-inline-flex gap-2 mt-2" do \|f\| %>\n    <%= f.file_field :file, accept: ".xlsx", class: "form-control form-control-sm w-auto" %>\n    <%= f.submit "Import Excel", class: "btn btn-warning btn-sm" %>\n  <% end %>|' app/views/meters/show.html.erb \
  && bundle exec rails javascript:build \
  && bundle exec rails assets:precompile

# new stage for Rails app
FROM debian:trixie-slim as rails

# install dependencies
RUN apt update && apt upgrade -y \
  && apt install -y --no-install-recommends --no-install-suggests libyaml-dev libssl-dev openssl \
  && apt install -y --no-install-recommends --no-install-suggests curl \
  && rm -rf "/var/lib/apt/lists/*" \
  && rm -rf /var/cache/apt/archives

# add user and set home directory
ARG USER=rails
RUN useradd --create-home --shell /bin/bash $USER
ARG HOME="/home/$USER"
WORKDIR $HOME
USER $USER

# copy rbenv, Ruby and Rails App from install stage (chown so SQLite can open/create the database file)
COPY --from=install --chown=$USER:$USER $HOME/.rbenv $HOME/.rbenv
ENV PATH="$HOME/.rbenv/shims:$PATH"
COPY --from=install --chown=$USER:$USER /rails/demo /rails/demo

WORKDIR /rails/demo

RUN mkdir -p tmp/sockets tmp/pids tmp/cache log storage

# generate self-signed TLS certificate
RUN mkdir -p config/ssl \
  && openssl req -x509 -newkey rsa:4096 -nodes -keyout config/ssl/server.key -out config/ssl/server.crt -days 365 -subj "/CN=localhost"

ENV RAILS_ENV=production

EXPOSE 3000

HEALTHCHECK --interval=35s --timeout=4s CMD curl --fail --insecure https://localhost:3000/up || exit 1

CMD ["sh", "-c", "bundle exec rails db:migrate 2>&1 || true && bundle exec rails server -b 'ssl://[::]:3000?key=config/ssl/server.key&cert=config/ssl/server.crt'"]
