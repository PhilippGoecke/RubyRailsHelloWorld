# syntax=docker/dockerfile:1

# Override at build time when the application requires another Ruby release:
# docker build --build-arg RUBY_VERSION=4.0.7 .
ARG RUBY_VERSION=4.0.7
FROM ruby:${RUBY_VERSION}-slim-trixie AS base

ENV RAILS_ENV=production \
    RACK_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN=1 \
    LANG=C.UTF-8

WORKDIR /rails

FROM base AS build

# Packages required to compile native gems and precompile Rails assets.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      pkg-config \
      nodejs \
      npm && \
    rm -rf /var/lib/apt/lists/*

# Install gems before application files so the layer is reused until dependencies change.
COPY Gemfile Gemfile.lock ./
RUN bundle install && \
    rm -rf /usr/local/bundle/cache /root/.bundle/cache

# Copy the complete Rails application and produce production assets.
COPY . .
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile && \
    bundle exec bootsnap precompile --gemfile app/ lib/ 2>/dev/null || true

FROM base AS production

# Runtime-only libraries. Add application-specific packages here if a gem needs them.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      ca-certificates \
      curl \
      libjemalloc2 \
      libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1000 rails && \
    useradd --system --uid 1000 --gid rails --create-home --shell /bin/bash rails

ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build --chown=rails:rails /rails /rails

# Rails needs these directories to remain writable at runtime.
RUN mkdir -p tmp/pids tmp/cache tmp/sockets log storage && \
    chown -R rails:rails tmp log storage

USER rails

EXPOSE 3000

# bin/docker-entrypoint content:
# #!/bin/bash -e
# if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
#   ./bin/rails db:prepare
# fi
# exec "${@}"
#
# Docker sends signals directly to the Rails server. Bind to all IPv6 interfaces.
# Enable IPv6 networking in the Docker daemon/orchestrator to publish IPv6 traffic.
ENTRYPOINT ["./bin/docker-entrypoint"]
CMD ["./bin/rails", "server", "-b", "::", "-p", "3000"]
