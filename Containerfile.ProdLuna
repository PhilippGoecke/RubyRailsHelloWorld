# syntax=docker/dockerfile:1

# Override at build time when the application requires another Ruby release:
# docker build --build-arg RUBY_VERSION=4.0.7 .
ARG RUBY_VERSION=4.0.7
FROM ruby:${RUBY_VERSION}-slim-trixie AS base

ENV RAILS_ENV=production \
    RACK_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN=1 \
    LANG=C.UTF-8 \
    HOME=/rails

WORKDIR /rails

LABEL org.opencontainers.image.title="Rails application" \
      org.opencontainers.image.description="Production Rails application image"

FROM base AS build

# Packages required to compile native gems and precompile Rails assets.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      git \
      libpq-dev \
      pkg-config \
      nodejs \
      npm && \
    rm -rf /var/lib/apt/lists/*

# Install gems before application files so the layer is reused until dependencies change.
COPY Gemfile Gemfile.lock ./
RUN bundle install && \
    rm -rf /usr/local/bundle/cache /root/.bundle/cache

# Copy the complete Rails application and produce production assets.
COPY . .
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile && \
    if bundle info bootsnap >/dev/null 2>&1; then \
      bundle exec bootsnap precompile --gemfile app/ lib/; \
    fi

FROM base AS production

# Runtime-only library for PostgreSQL. Development and build dependencies
# remain isolated in the build stage.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      ca-certificates \
      libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1000 rails && \
    useradd --system --uid 1000 --gid rails \
      --no-create-home --shell /usr/sbin/nologin rails

# Application and gems are root-owned and read-only. Only Rails' runtime
# directories are writable by the unprivileged process.
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /rails /rails
RUN chmod -R go-w /rails /usr/local/bundle && \
    mkdir -p tmp/pids tmp/cache tmp/sockets log storage && \
    chown -R 1000:1000 tmp log storage && \
    chmod -R u=rwX,g=rX,o= tmp log storage

USER 1000:1000

EXPOSE 3000

# bin/docker-entrypoint content:
# #!/bin/bash -e
# if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
#   ./bin/rails db:prepare
# fi
# exec "${@}"
#
# Docker sends signals directly to the Rails server. Bind to all IPv6 interfaces.
# Enable IPv6 networking in the Docker daemon/orchestrator to publish IPv6 traffic.
#
# Deploy with a read-only root filesystem and runtime restrictions, for example:
# docker run --read-only --tmpfs /tmp --cap-drop=ALL --security-opt no-new-privileges \
#   --publish "[::]:3000:3000" your-image
ENTRYPOINT ["./bin/docker-entrypoint"]
CMD ["./bin/rails", "server", "-b", "::", "-p", "3000"]
